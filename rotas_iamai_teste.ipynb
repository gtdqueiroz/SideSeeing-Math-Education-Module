      "source": [
        "# SideSeeing · exploração inicial\n"
        "Lembre de ajustar PASTA_COLETAS_DRIVE para o caminho do seu próprio Drive.\n"
      ],
      "metadata": {
        "id": "SvUHjADqZOPX"
      }
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Wtu3Ks8DyAQG"
      },
      "outputs": [],
      "source": [
        "from pathlib import Path\n",
        "import json\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "PASTA_COLETAS_DRIVE = Path(\"/content/drive/MyDrive/IC-Fapesp/ROTAS-E-TESTES/ROTAS-12-10-2026\")\n",
        "PASTA_COLETAS_LOCAL = Path(\"upload\") if Path(\"upload\").is_dir() else Path(\".\")\n",
        "INDICE_ROTA = 0  # Escolha o número mostrado na lista abaixo.\n",
        "\n",
        "try:\n",
        "    from google.colab import drive\n",
        "except ImportError:\n",
        "    pasta_coletas = PASTA_COLETAS_LOCAL\n",
        "else:\n",
        "    drive.mount(\"/content/drive\")\n",
        "    pasta_coletas = PASTA_COLETAS_DRIVE\n",
        "\n",
        "if not pasta_coletas.is_dir():\n",
        "    raise FileNotFoundError(f\"Pasta não encontrada: {pasta_coletas}. Confira o caminho.\")\n",
        "\n",
        "arquivo_principal = \"sensors.three.csv\"\n",
        "if (pasta_coletas / arquivo_principal).is_file():\n",
        "    rotas = [pasta_coletas]\n",
        "else:\n",
        "    rotas = sorted(arquivo.parent for arquivo in pasta_coletas.rglob(arquivo_principal))\n",
        "\n",
        "if not rotas:\n",
        "    raise FileNotFoundError(f\"Nenhuma pasta com {arquivo_principal} em {pasta_coletas}.\")\n",
        "\n",
        "print(\"Rotas encontradas:\")\n",
        "for indice, pasta in enumerate(rotas):\n",
        "    print(f\"  {indice}: {pasta.relative_to(pasta_coletas) if pasta != pasta_coletas else pasta.name}\")\n",
        "\n",
        "if not 0 <= INDICE_ROTA < len(rotas):\n",
        "    raise ValueError(\"Escolha em INDICE_ROTA um número da lista acima.\")\n",
        "ROTA = rotas[INDICE_ROTA]\n",
        "print(f\"\\nRota selecionada: {ROTA}\\n\")\n",
        "\n",
        "arquivos = [\"sensors.three.csv\", \"sensors.three.uncalibrated.csv\",\n",
        "            \"sensors.one.csv\", \"consumption.csv\"]\n",
        "dados = {}\n",
        "for nome in arquivos:\n",
        "    caminho = ROTA / nome\n",
        "    if caminho.is_file():\n",
        "        dados[nome] = pd.read_csv(caminho, dtype={\"timestamp_nano\": \"Int64\"})\n",
        "        dados[nome][\"datetime_utc\"] = pd.to_datetime(\n",
        "            dados[nome][\"datetime_utc\"], utc=True, errors=\"coerce\"\n",
        "        )\n",
        "        print(f\"{nome}: {len(dados[nome]):,} linhas\")\n",
        "\n",
        "caminho_meta = ROTA / \"metadata.json\"\n",
        "meta = json.loads(caminho_meta.read_text(encoding=\"utf-8\")) if caminho_meta.is_file() else {}\n",
        "tempos = meta.get(\"time\", {})\n",
        "inicio_video = pd.to_datetime(tempos.get(\"mediaStartDateTime\"), utc=True)\n",
        "fim_video = pd.to_datetime(tempos.get(\"mediaStopDateTime\"), utc=True)\n",
        "if pd.notna(inicio_video) and pd.notna(fim_video):\n",
        "    print(f\"Duração registrada do vídeo: {(fim_video - inicio_video).total_seconds():.1f} s\")\n",
        "print(\"deviceStartAngle:\", meta.get(\"deviceStartAngle\", \"ausente\"))"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "**1. Inventário e relógio dos sensores**\n",
        "\n",
        "\n",
        "O zero de t_s é o primeiro timestamp encontrado nos CSVs de sensores. Para alinhar aproximadamente com o vídeo, t_video_s usa o início da gravação no JSON.\n",
        "\n",
        "Valores negativos representam leituras anteriores ao início do vídeo. A frequência típica é o inverso da mediana dos intervalos positivos de cada sensor. O maior intervalo ajuda a localizar possíveis lacunas."
      ],
      "metadata": {
        "id": "TkeUUAJbiLtw"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "t0 = min(\n",
        "    int(tabela[\"timestamp_nano\"].min())\n",
        "    for tabela in dados.values()\n",
        "    if \"timestamp_nano\" in tabela and tabela[\"timestamp_nano\"].notna().any()\n",
        ")\n",
        "resumo = []\n",
        "for arquivo, tabela in dados.items():\n",
        "    if pd.notna(inicio_video):\n",
        "        tabela[\"t_video_s\"] = (tabela[\"datetime_utc\"] - inicio_video).dt.total_seconds()\n",
        "    if \"timestamp_nano\" not in tabela:\n",
        "        continue\n",
        "    tabela.sort_values(\"timestamp_nano\", inplace=True)\n",
        "    tabela[\"t_s\"] = (tabela[\"timestamp_nano\"] - t0).astype(float) / 1e9\n",
        "    for sensor, grupo in tabela.groupby(\"name\"):\n",
        "        dt = grupo[\"t_s\"].diff()\n",
        "        positivos = dt[dt > 0]\n",
        "        resumo.append({\n",
        "            \"arquivo\": arquivo, \"sensor\": sensor, \"amostras\": len(grupo),\n",
        "            \"hz_típicos\": 1 / positivos.median() if len(positivos) else np.nan,\n",
        "            \"maior_intervalo_s\": positivos.max(),\n",
        "            \"timestamps_repetidos\": int((dt == 0).sum()),\n",
        "        })\n",
        "\n",
        "inventario = pd.DataFrame(resumo)\n",
        "print(inventario.round(3).to_string(index=False, na_rep=\"—\"))"
      ],
      "metadata": {
        "id": "JmlGRwPFiYkq"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "**2. Veja os sinais antes de escolher um trecho**\n",
        "\n",
        "Os três eixos estão no referencial do celular. O acelerômetro inclui a contribuição da gravidade. linear_acc é a estimativa do aparelho para a aceleração sem essa contribuição. Os gráficos preservam os instantes de amostragem de cada sensor.\n",
        "\n",
        "Precisamos ajustar JANELA em segundos para aproximar cada manobra.\n",
        "\n"
      ],
      "metadata": {
        "id": "6IOOK7ufibdF"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "JANELA = (None, None)  # Exemplo: (10, 20), no relógio t_s\n",
        "eixos = [\"axis_x\", \"axis_y\", \"axis_z\"]\n",
        "sensores = dados[\"sensors.three.csv\"]\n",
        "sinais = {nome: grupo.dropna(subset=[\"t_s\", *eixos])\n",
        "          for nome, grupo in sensores.groupby(\"name\")}\n",
        "\n",
        "painel = {\n",
        "    \"lsm6dsvq_acc\": (\"Acelerômetro\", \"m/s²\"),\n",
        "    \"linear_acc\": (\"Aceleração linear\", \"m/s²\"),\n",
        "    \"gravity\": (\"Gravidade estimada\", \"m/s²\"),\n",
        "    \"lsm6dsvq_gyro\": (\"Giroscópio\", \"rad/s\"),\n",
        "}\n",
        "presentes = [nome for nome in painel if nome in sinais and not sinais[nome].empty]\n",
        "if presentes:\n",
        "    fig, axs = plt.subplots(len(presentes), 1, figsize=(11, 2.25 * len(presentes)),\n",
        "                            sharex=True, squeeze=False, layout=\"constrained\")\n",
        "    for ax, nome in zip(axs[:, 0], presentes):\n",
        "        titulo, unidade = painel[nome]\n",
        "        for eixo, cor in zip(eixos, [\"#0072B2\", \"#D55E00\", \"#009E73\"]):\n",
        "            ax.plot(sinais[nome][\"t_s\"], sinais[nome][eixo],\n",
        "                    label=eixo[-1].upper(), color=cor, linewidth=0.9)\n",
        "        ax.set(title=titulo, ylabel=unidade)\n",
        "        ax.grid(alpha=0.25)\n",
        "        ax.legend(ncol=3, loc=\"upper right\")\n",
        "    axs[-1, 0].set(xlabel=\"Tempo desde a primeira leitura (s)\", xlim=JANELA)\n",
        "    plt.show()"
      ],
      "metadata": {
        "id": "vvlGYX_-imh-"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "**3. Experimento de inclinação**\n",
        "\n",
        "Vamos medir o ângulo entre o eixo escolhido do celular e a direção do vetor gravity. O resultado vai de 0° (mesmo sentido) a 180° (sentido oposto). Com o eixo Z, 90° indica que esse eixo está na horizontal.\n",
        "\n",
        "Devemos usar as posições conhecidas para conferir o sinal e o zero. Para estimar a elevação da câmera é preciso identificar o sentido do eixo óptico e marcar no vídeo quando ele aponta para o topo do poste."
      ],
      "metadata": {
        "id": "qi8l4ckCis-0"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "EIXO_INCLINACAO = \"axis_z\"\n",
        "gravidade = sinais.get(\"gravity\")\n",
        "if gravidade is not None and not gravidade.empty:\n",
        "    g = gravidade[eixos].to_numpy()\n",
        "    norma = np.linalg.norm(g, axis=1)\n",
        "    valido = norma > 0\n",
        "    cosseno = gravidade.loc[valido, EIXO_INCLINACAO].to_numpy() / norma[valido]\n",
        "    angulo = np.degrees(np.arccos(np.clip(cosseno, -1, 1)))\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(11, 2.8), layout=\"constrained\")\n",
        "    ax.plot(gravidade.loc[valido, \"t_s\"], angulo, color=\"#0072B2\")\n",
        "    ax.axhline(90, color=\"0.5\", linestyle=\"--\", linewidth=1)\n",
        "    ax.set(xlabel=\"Tempo desde a primeira leitura (s)\", ylabel=\"Ângulo (°)\",\n",
        "           title=f\"Ângulo entre {EIXO_INCLINACAO} e o vetor gravity\", xlim=JANELA)\n",
        "    ax.grid(alpha=0.25)\n",
        "    plt.show()\n",
        "else:\n",
        "    print(\"Esta coleta não tem leituras utilizáveis de gravity.\")"
      ],
      "metadata": {
        "id": "dDTbyS9RjTBY"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
